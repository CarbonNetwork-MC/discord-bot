# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=database

# Bot Configuration
TOKEN="YOUR_BOT_TOKEN"
ENVIRONMENT="development"  # Options: development, production
DEPLOY_COMMANDS="false" # Options: true, false
CLEAR_COMMANDS="false" # Options: true, false
LOGGING="single" # Options: single, timebased, extended, timebased-extended

# IDs
OWNER_ID=""
CLIENT_ID=""
DEV_GUILD_ID=""

# Watchdog Configuration
WATCHDOG_ENABLED="true" # Options: true, false
WATCHDOG_SERVERS="" # Comma-separated list of server IDs to monitor
WATCHDOG_OUTPUT_TYPE="console" # Options: console, webhook, channel, dm
WATCHDOG_OUTPUT_ID="" # ID of the output destination (channel ID, webhook URL, or user ID)

# Embed Configuration
EMBED_FOOTER="© Carbon Network | 2024 - 2026"
COLOR_BLUE="#3896fc"
COLOR_RED="#DD5E53"
COLOR_GREEN="#53DDAD"
COLOR_YELLOW="#F2C94C"
COLOR_ORANGE="#F2994A"